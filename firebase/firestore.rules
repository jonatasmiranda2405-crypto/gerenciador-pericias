rules_version = '2';

// Regras do Cloud Firestore do Gerenciador de Perícia.
// Publicar: Firebase Console > Firestore Database > Regras (cole este arquivo e clique em Publicar)
// ou `firebase deploy --only firestore:rules`. Testes em firebase/testes/ (rodam no GitHub Actions).
//
// Modelo de acesso:
//   usuarios/{uid}         só o próprio usuário (cadastro, preferências, chave da IA)
//   casos/{casoId}         lê quem está em `emails`; altera quem está em `editores` (só o `dono`
//                          tira ou rebaixa alguém); apaga só o `dono`
//   casos/{id}/documentos  lê quem lê a perícia; grava quem edita a perícia
//   config/*               só leitura, só para as três contas antigas (migração do cadastro)
//   erros/*                cada conta registra o próprio erro; só os administradores leem
//   comercial/*            contatos do agente comercial; só os administradores
//   conversoes/{uid}       quem criou conta pelo link de um convite; a própria conta grava uma vez,
//                          só os administradores leem
//   todo o resto           fechado
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function verificado() {
      return logado()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function legado() {
      return verificado() && email() in [
        'jonatasmiranda2405@gmail.com',
        'rodrigodosantosmiranda@gmail.com',
        'periciamiranda@gmail.com'
      ];
    }
    // Administradores: só com a entrada pelo Google (que tem a verificação em duas etapas da conta).
    function admin() {
      return verificado()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && email() in [
        'jonatasmiranda2405@gmail.com',
        'rodrigodosantosmiranda@gmail.com'
      ];
    }
    function textoAte(v, n) {
      return v is string && v.size() <= n;
    }
    function idValido(id) {
      return id.matches('^[A-Za-z0-9_-]{1,150}$');
    }

    // ---------- perfil pessoal ----------
    match /usuarios/{uid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      // o e-mail gravado no perfil, quando existe, é sempre o da própria conta
      allow create, update: if logado() && request.auth.uid == uid
        && (!('email' in request.resource.data)
            || request.resource.data.email == ''
            || request.resource.data.email.lower() == request.auth.token.email.lower());
    }

    // ---------- legado (só leitura, contas antigas) ----------
    match /config/{doc} {
      allow read: if legado();
      allow write: if false;
    }

    // ---------- perícias ----------
    // Escrito como `email() in d.emails` para o Firestore conseguir provar a consulta
    // where('emails', 'array-contains', email) sem ler documento por documento.
    function ehMembro(d) {
      return email() in d.emails;
    }
    function ehEditor(d) {
      return email() in d.editores;
    }
    function semAcessos(d) {
      return !('dono' in d) || !('emails' in d) || !('editores' in d);
    }
    // Estrutura de acesso que toda perícia gravada precisa manter.
    function acessosCoerentes(d) {
      return d.dono is string
        && d.emails is list && d.editores is list
        && d.emails.size() >= 1 && d.emails.size() <= 50
        && d.editores.size() >= 1
        && d.dono in d.emails
        && d.dono in d.editores
        && d.emails.hasAll(d.editores)
        && (!('compartilhamentos' in d) || (d.compartilhamentos is list && d.compartilhamentos.size() <= 50));
    }

    match /casos/{casoId} {
      allow read: if verificado()
        && (ehMembro(resource.data) || (semAcessos(resource.data) && legado()));

      allow create: if verificado()
        && idValido(casoId)
        && acessosCoerentes(request.resource.data)
        && request.resource.data.dono == email();

      allow update: if verificado()
        && acessosCoerentes(request.resource.data)
        && (
          // dono: altera tudo, menos a própria posição de dono
          ('dono' in resource.data && resource.data.dono == email() && request.resource.data.dono == resource.data.dono)
          // editor: altera a perícia e pode convidar, mas não tira nem rebaixa ninguém
          || (ehEditor(resource.data)
              && request.resource.data.dono == resource.data.dono
              && request.resource.data.emails.hasAll(resource.data.emails)
              && request.resource.data.editores.hasAll(resource.data.editores))
          // migração das perícias antigas, feita por uma das contas antigas
          || (semAcessos(resource.data) && legado())
        );

      allow delete: if verificado()
        && (('dono' in resource.data && resource.data.dono == email())
            || (semAcessos(resource.data) && legado()));

      match /documentos/{docId} {
        function caso() {
          return get(/databases/$(database)/documents/casos/$(casoId)).data;
        }
        allow read: if verificado()
          && (ehMembro(caso()) || (semAcessos(caso()) && legado()));
        allow create, update: if verificado()
          && idValido(docId)
          && (ehEditor(caso()) || (semAcessos(caso()) && legado()));
        allow delete: if verificado()
          && (ehEditor(caso()) || (semAcessos(caso()) && legado()));
      }
    }

    // ---------- erros do navegador (vigia da Central do administrador) ----------
    // Qualquer conta confirmada registra o próprio erro; só os administradores leem e apagam.
    match /erros/{id} {
      allow create: if verificado()
        && id == request.auth.uid + '_' + request.resource.data.chave
        && request.resource.data.keys().hasOnly(['tipo', 'msg', 'origem', 'pilha', 'secao', 'navegador', 'versao', 'email', 'quando', 'chave'])
        && request.resource.data.keys().hasAll(['tipo', 'msg', 'chave', 'quando', 'email', 'versao', 'secao'])
        && request.resource.data.tipo in ['erro', 'promessa']
        && request.resource.data.chave is string && request.resource.data.chave.matches('^r[0-9a-z]{1,10}$')
        && request.resource.data.versao is string && request.resource.data.versao.matches('^[0-9.]{1,20}$')
        && request.resource.data.secao is string && request.resource.data.secao.matches('^[a-z]{0,40}$')
        && request.resource.data.quando == request.time
        && textoAte(request.resource.data.msg, 500)
        && textoAte(request.resource.data.get('origem', ''), 300)
        && textoAte(request.resource.data.get('pilha', ''), 3000)
        && textoAte(request.resource.data.get('navegador', ''), 240)
        && request.resource.data.email == email();
      allow read, delete: if admin();
      allow update: if false;
    }

    // ---------- agente comercial (só administradores) ----------
    match /comercial/{id} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && id.matches('^r[0-9a-z]{1,12}$')
        && request.resource.data.keys().hasOnly(['email', 'nome', 'cidade', 'origem', 'status', 'convite', 'criadoEm', 'notas', 'enviadoEm', 'lembradoEm', 'contaEm'])
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@ ]{1,120}@[^@ ]{1,120}$')
        && request.resource.data.status in ['novo', 'convidado', 'lembrado', 'conta', 'cliente', 'nao']
        && request.resource.data.convite is string && request.resource.data.convite.matches('^[a-z0-9]{4,16}$')
        && textoAte(request.resource.data.get('nome', ''), 80)
        && textoAte(request.resource.data.get('cidade', ''), 60)
        && textoAte(request.resource.data.get('origem', ''), 60)
        && textoAte(request.resource.data.get('notas', ''), 1000);
    }

    // ---------- quem chegou pelo link de convite ----------
    // A própria conta (confirmada) grava uma única vez, com o próprio e-mail e o horário do servidor.
    match /conversoes/{uid} {
      allow create: if verificado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['convite', 'email', 'quando'])
        && request.resource.data.keys().hasAll(['convite', 'email', 'quando'])
        && request.resource.data.convite is string && request.resource.data.convite.matches('^[a-z0-9]{4,16}$')
        && request.resource.data.email == email()
        && request.resource.data.quando == request.time;
      allow read, delete: if admin();
      allow update: if false;
    }

    // Qualquer outro caminho: fechado.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
